{
  "name": "RoninFlow",
  "short_name": "RoninFlow",
  "description": "Your trading journal, diary, reviews and coach.",
  "id": "/",
  "start_url": "/#/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Daily Diary", "url": "/#/diary", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Review", "url": "/#/review/weekly", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Trading Coach", "url": "/#/coach", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
