#!/usr/bin/env bash
# RoninFlow for macOS and Linux — manage the app installed by install.sh.
#   roninflow open | status | start | stop | restart | logs | update | uninstall [--purge] | version
#   roninflow run                       (what the background service runs; you don't normally need it)
set -euo pipefail

# where this script lives: <home>/app/bin/roninflow  (follow the ~/.local/bin symlink)
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do dir="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"; [[ $src != /* ]] && src="$dir/$src"; done
APP="$(cd -P "$(dirname "$src")/.." && pwd)"
HOME_DIR="$(dirname "$APP")"
NODE="$APP/node/bin/node"
OS="$(uname -s)"
LABEL="com.roninflow.server"
UNIT="roninflow.service"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"

PORT=5173; LAN=0
# shellcheck disable=SC1091
[ -f "$HOME_DIR/install.env" ] && . "$HOME_DIR/install.env"
URL="http://localhost:$PORT"

say() { printf '%s\n' "$*"; }
has() { command -v "$1" >/dev/null 2>&1; }
up() { curl -fsS -m 2 "$URL/healthz" >/dev/null 2>&1; }
manager() {
  if [ "$OS" = Darwin ]; then [ -f "$PLIST" ] && echo launchd && return; fi
  if has systemctl && systemctl --user cat "$UNIT" >/dev/null 2>&1; then echo systemd; return; fi
  echo none
}

run_server() {
  mkdir -p "$HOME_DIR/data" "$HOME_DIR/drop" "$HOME_DIR/logs"
  cd "$APP"
  export DATA_DIR="$HOME_DIR/data" PORT TJ_DROP_DIR="$HOME_DIR/drop" TJ_INSTALL=unix
  [ "$LAN" = 1 ] && export TJ_LAN=1
  [ "${1:-}" = --service ] && export TJ_SERVICE=1   # restarted by the service manager, so "Update now" can restart it
  exec "$NODE" server.js
}

start_bg() { # no service manager: plain background process
  nohup "$APP/bin/roninflow" run >>"$HOME_DIR/logs/server.log" 2>&1 &
  echo $! >"$HOME_DIR/server.pid"
}

wait_up() { for _ in $(seq 1 40); do up && return 0; sleep 0.5; done; return 1; }

case "${1:-help}" in
  run) shift; run_server "$@" ;;
  start)
    case "$(manager)" in
      launchd) launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || launchctl kickstart "gui/$(id -u)/$LABEL" ;;
      systemd) systemctl --user start "$UNIT" ;;
      none) up || start_bg ;;
    esac
    wait_up && say "RoninFlow is running at $URL" || { say "RoninFlow didn't start — see: roninflow logs"; exit 1; } ;;
  stop)
    case "$(manager)" in
      launchd) launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true ;;
      systemd) systemctl --user stop "$UNIT" ;;
      none) [ -f "$HOME_DIR/server.pid" ] && kill "$(cat "$HOME_DIR/server.pid")" 2>/dev/null; rm -f "$HOME_DIR/server.pid" ;;
    esac
    say "RoninFlow stopped." ;;
  restart) "$0" stop >/dev/null; sleep 1; "$0" start ;;
  status)
    say "RoninFlow $("$NODE" -p "require('$APP/package.json').version" 2>/dev/null || echo '?') · $(manager) · $(up && echo "running at $URL" || echo 'not running')"
    say "App:  $APP"; say "Data: $HOME_DIR/data" ;;
  open)
    up || "$0" start >/dev/null
    if [ "$OS" = Darwin ]; then open "$URL"; elif has xdg-open; then xdg-open "$URL" >/dev/null 2>&1 & else say "Open $URL in your browser."; fi ;;
  logs)
    if [ "$(manager)" = systemd ]; then journalctl --user -u "$UNIT" -n 100 -f; else tail -n 100 -f "$HOME_DIR/logs/server.log"; fi ;;
  update)
    curl -fsSL "https://raw.githubusercontent.com/${RONINFLOW_REPO:-coreyheyman/roninflow}/main/install.sh" | bash -s -- --update ;;
  uninstall)
    "$0" stop >/dev/null 2>&1 || true
    case "$(manager)" in
      launchd) rm -f "$PLIST" ;;
      systemd) systemctl --user disable "$UNIT" >/dev/null 2>&1 || true; rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT"; systemctl --user daemon-reload || true ;;
    esac
    rm -f "$HOME/.local/bin/roninflow"
    if [ "${2:-}" = --purge ]; then rm -rf "$HOME_DIR"; say "RoninFlow and your journal data were removed.";
    else rm -rf "$APP" "$APP.old"; say "RoninFlow was removed. Your journal is still in $HOME_DIR/data (delete that folder to remove it too)."; fi ;;
  version) "$NODE" -p "require('$APP/package.json').version" ;;
  *) sed -n '2,4p' "$APP/bin/roninflow" | sed 's/^# \{0,1\}//' ;;
esac
