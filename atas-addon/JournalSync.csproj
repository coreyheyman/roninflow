<Project Sdk="Microsoft.NET.Sdk">

  <!-- Journal Sync add-on for ATAS X.
       Build and install from the RoninFlow folder with: npm run addon
       (it runs atas-addon\install.ps1, which finds ATAS X and passes its folder as ATAS_BASE). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Windows Forms + WebView2 (both part of ATAS X) for the journal and trade-review windows over the chart -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>JournalSync</AssemblyName>
    <RootNamespace>TradeJournal</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS8618;CS8602;CS8604</NoWarn>
    <ATAS_BASE Condition=" '$(ATAS_BASE)' == '' ">C:\Program Files\ATAS X</ATAS_BASE>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="JournalSync.cs" />
    <Compile Include="RiskGuard.cs" />
    <Compile Include="RoninFlowHud.cs" />
    <Compile Include="RoninFlowHud.Extras.cs" />
    <Compile Include="RoninFlowHud.Block.cs" />
    <Compile Include="RoninFlowHud.Candles.cs" />
    <Compile Include="RoninFlowWindows.cs" />
  </ItemGroup>

  <!-- Platform assemblies come from the installed ATAS X and are not copied to the output. -->
  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>$(ATAS_BASE)\ATAS.Indicators.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>$(ATAS_BASE)\ATAS.DataFeedsCore.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OFT.Rendering">
      <HintPath>$(ATAS_BASE)\OFT.Rendering.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- System.Drawing (FontStyle, DashStyle) now comes with Windows Forms from the Windows Desktop runtime ATAS X runs on -->
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(ATAS_BASE)\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>$(ATAS_BASE)\Microsoft.Web.WebView2.WinForms.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OFT.Attributes">
      <HintPath>$(ATAS_BASE)\OFT.Attributes.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Utils.Common">
      <HintPath>$(ATAS_BASE)\Utils.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
